# LD low-resource deployment only. Verify the local base tag's image ID first.
# Full clean builds continue to use backend/Dockerfile; this contains no dependencies.
ARG BASE_IMAGE=ld-sprintable-backend:b91c2cbbad27
FROM ${BASE_IMAGE}
ARG SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.revision=${SOURCE_COMMIT}
# OpenAI: all application files come from one Git revision, including JSON catalogs.
# Only use this with the verified matching dependency/schema baseline.
COPY backend/app /app/app
