# LD low-resource deployment only. Verify the local base tag's image ID first.
# Full clean builds continue to use backend/Dockerfile; this contains no dependencies.
ARG BASE_IMAGE=ld-sprintable-backend:b91c2cbbad27
FROM ${BASE_IMAGE}
COPY backend/app/main.py /app/app/main.py
COPY backend/app/routers/local_storage.py /app/app/routers/local_storage.py
COPY backend/app/routers/team_members.py /app/app/routers/team_members.py
COPY backend/app/repositories/team_member.py /app/app/repositories/team_member.py
COPY backend/app/services/avatar_upload.py /app/app/services/avatar_upload.py
COPY backend/app/services/storage/local.py /app/app/services/storage/local.py
